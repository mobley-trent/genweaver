# genweaver — public entry point (used only by compose.https.yaml).
#
# One site, one upstream: the API serves both the REST surface at /api/v1 and
# whatever UI build ships inside the api image, so there is no second origin
# and no CORS. TLS is obtained from Let's Encrypt automatically; HTTP is
# redirected to HTTPS.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Transport-level ceiling for multipart uploads, deliberately ABOVE the
	# app's own 50 MiB limit (UPLOAD_MAX_BYTES, ADR 0009) so a body the app
	# would accept is never refused here with an untyped 413: the app answers
	# with its problem+json payload_too_large. This only stops a body far past
	# the limit before FastAPI buffers it.
	request_body {
		max_size 55MB
	}

	reverse_proxy api:8000 {
		# Answers are text/event-stream (ADR 0009): buffer nothing, or the
		# tokens arrive in one lump when the stream ends.
		flush_interval -1
	}

	log
}
