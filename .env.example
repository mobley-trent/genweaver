# genweaver — environment template.
#
#   cp .env.example .env && chmod 600 .env
#
# .env is the only place these live: it is gitignored, mounted by nothing, and
# read by Compose for interpolation. Internal wiring (DATABASE_URL, QDRANT_URL,
# EMBEDDING_BASE_URL) is assembled in compose.yaml and must not be set here.
#
# Required values fail the stack closed: `docker compose up` refuses to start
# rather than booting with an empty password, key or unpinned model.

# ── state credentials ────────────────────────────────────────────────────
# Generate both:  openssl rand -base64 32
POSTGRES_PASSWORD=
QDRANT_API_KEY=

# The origin the browser uses. Local default; compose.https.yaml replaces it
# with https://${DOMAIN}. CSRF Origin checking and absolute links read it.
APP_ORIGIN=http://localhost:8000

# ── public deployment (compose.https.yaml only) ──────────────────────────
# DOMAIN is the hostname whose A record points here; Caddy issues its cert.
DOMAIN=
ACME_EMAIL=

# ── chat provider (ADR 0007) ─────────────────────────────────────────────
CHAT_PROVIDER=deepseek
CHAT_MODEL=deepseek-flash
CHAT_BASE_URL=https://api.deepseek.com
CHAT_API_KEY=
CHAT_THINKING=off
CHAT_TEMPERATURE=0.2

# ── embeddings: TEI sidecar serving the pinned model ─────────────────────
EMBEDDING_PROVIDER=tei
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMS=1024
# A commit sha, not a branch: it is part of answer provenance and of what the
# collection holds. Resolve it with:
#   curl -fsSL https://huggingface.co/api/models/Qwen/Qwen3-Embedding-0.6B \
#     | python3 -c 'import json,sys; print(json.load(sys.stdin)["sha"])'
EMBEDDING_REVISION=

# ── verifier: in-process in the api (ADR 0012) ───────────────────────────
VERIFIER_MODEL=hhem-2.1-open
# Commit sha of vectara/hallucination_evaluation_model at the pinned revision.
VERIFIER_REVISION=

# ── budgets (ADR 0008) ───────────────────────────────────────────────────
BUDGET_ACCOUNT_MONTHLY_USD=5.00
BUDGET_ACCOUNT_DAILY_SOFT_USD=1.00
BUDGET_DEPLOYMENT_MONTHLY_USD=50.00

# ── runtime ──────────────────────────────────────────────────────────────
# Keep at 1 on an 8 GB host: the Docling parse is the memory spike.
WORKER_CONCURRENCY=1
# App-side upload ceiling, 50 MiB (ADR 0009). Caddy's request_body cap sits
# above it so the app returns the typed payload_too_large, not the proxy's 413.
UPLOAD_MAX_BYTES=52428800
API_PORT=8000
LOG_LEVEL=INFO
